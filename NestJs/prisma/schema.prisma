// Prisma Schema
// 定义数据库模型

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  nickname  String?  @db.VarChar(50)
  avatar    String?  @db.VarChar(255)
  phone     String?  @unique @db.VarChar(20)
  status    Int      @default(1) @db.TinyInt // 1:正常 0:禁用
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 关联关系
  roles         UserRole[]
  articles      Article[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// 角色表
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  code        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  status      Int      @default(1) @db.TinyInt // 1:正常 0:禁用
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 关联关系
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

// 用户角色关联表（多对多）
model UserRole {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")
  roleId Int @map("role_id")

  // 关联关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// 分类表
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  slug        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  parentId    Int?     @map("parent_id")
  sort        Int      @default(0)
  status      Int      @default(1) @db.TinyInt // 1:正常 0:禁用
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 关联关系
  articles Article[]

  @@map("categories")
}

// 文章表
model Article {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(200)
  slug       String   @unique @db.VarChar(200)
  summary    String?  @db.Text
  content    String   @db.LongText
  cover      String?  @db.VarChar(255)
  authorId   Int      @map("author_id")
  categoryId Int      @map("category_id")
  viewCount  Int      @default(0) @map("view_count")
  likeCount  Int      @default(0) @map("like_count")
  status     Int      @default(1) @db.TinyInt // 1:已发布 0:草稿
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // 关联关系
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([authorId])
  @@index([categoryId])
  @@map("articles")
}

// Refresh Token 表
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  isRevoked Boolean  @default(false) @map("is_revoked") // 是否已撤销

  // 关联关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// 权限表（RBAC 标准模型 - 统一管理菜单和API权限）
model Permission {
  id          Int      @id @default(autoincrement())
  parentId    Int?     @map("parent_id") // 父权限ID，支持树形结构（菜单层级）
  
  // ========== 核心字段 ==========
  name        String   @db.VarChar(50) // 权限名称（英文标识，如：UserManage）
  code        String?  @unique @db.VarChar(100) // 权限代码（如：user:create），目录类型可为空
  type        Int      @db.TinyInt // 权限类型：M-目录 C-菜单 A-按钮 API-纯API
  
  // ========== 前端展示字段（type=M,C 时使用）==========
  title       String?  @db.VarChar(50) // 显示标题（中文，如：用户管理）
  icon        String?  @db.VarChar(50) // 图标名称
  path        String?  @db.VarChar(200) // 路由路径
  component   String?  @db.VarChar(200) // 组件路径（仅菜单使用）
  redirect    String?  @db.VarChar(200) // 重定向路径（仅目录使用）
  visible     Boolean  @default(true) // 是否在菜单中显示
  keepAlive   Boolean  @default(false) // 页面是否缓存
  
  // ========== 扩展字段 ==========
  description String?  @db.VarChar(500) // 描述说明
  metadata    Json?    // 扩展配置（数据权限、字段权限等）
  sort        Int      @default(0) // 排序号
  status      Int      @default(1) @db.TinyInt // 状态：1-启用 0-禁用
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 关联关系
  roles RolePermission[]

  // 优化索引
  @@index([parentId])
  @@index([type, status])
  @@index([code])
  @@map("permissions")
}

// 角色权限关联表（多对多）
model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  // 关联关系
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}
