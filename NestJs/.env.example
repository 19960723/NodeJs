# ========================================
# 应用配置
# ========================================

# 应用名称
APP_NAME="NestJS Enterprise App"

# 运行环境: development | production | test
NODE_ENV=development

# 服务端口
PORT=3000

# ========================================
# 数据库配置
# ========================================

# MySQL 连接字符串
# 格式: mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL="mysql://root:password@localhost:3306/nestjs_db"

# ========================================
# JWT 认证配置
# ========================================

# JWT 密钥 (生产环境务必修改为强密码)
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# Access Token 过期时间
JWT_EXPIRES_IN=7d

# Refresh Token 过期时间
JWT_REFRESH_EXPIRES_IN=30d

# ========================================
# Swagger 文档配置
# ========================================

# 是否启用 Swagger 文档
SWAGGER_ENABLE=true

# Swagger 访问路径
SWAGGER_PATH=api/docs

# ========================================
# 日志配置
# ========================================

# 日志级别: error | warn | info | debug | verbose
LOG_LEVEL=debug

# 是否启用控制台日志
LOG_CONSOLE=true

# 是否启用文件日志
LOG_FILE=true

# 日志文件路径
LOG_DIR=logs

# ========================================
# Redis 配置 (可选)
# ========================================

# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_KEY_PREFIX=nestjs:

# ========================================
# 限流配置
# ========================================

THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ========================================
# CORS 跨域配置
# ========================================

CORS_ORIGIN=*

# ========================================
# 其他配置
# ========================================

TZ=Asia/Shanghai
ENABLE_REQUEST_LOG=true
ENABLE_ERROR_STACK=true
