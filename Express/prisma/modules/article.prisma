// 资讯分类
model ArticleCategory {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sort      Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  articles  Article[]
}

// 资讯列表
model Article {
  id          Int               @id @default(autoincrement())
  title       String
  content     String
  coverImage  String?                            // 封面图
  authorId    Int
  categoryId  Int

  views       Int               @default(0)      // 浏览量
  likesCount  Int               @default(0)      // 点赞数（缓存统计）
  favCount    Int               @default(0)      // 收藏数（缓存统计）

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // 关系
  category    ArticleCategory   @relation(fields: [categoryId], references: [id])
  author      User              @relation(fields: [authorId], references: [id])
  comments    ArticleComment[]
  likes       ArticleLike[]
  favorites   ArticleFavorite[]
}

// 资讯评论
model ArticleComment {
  id        Int       @id @default(autoincrement())
  articleId Int
  userId    Int
  parentId  Int?                            // 父评论ID（楼中楼）

  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  article   Article  @relation(fields: [articleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  parent    ArticleComment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   ArticleComment[] @relation("CommentReplies")
}

// 资讯点赞（多对多关系表）
model ArticleLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  articleId Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  article   Article  @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId]) // 一个用户对一篇文章只能点赞一次
}

// 资讯收藏（多对多关系表）
model ArticleFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  articleId Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  article   Article  @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId]) // 一个用户对一篇文章只能收藏一次
}