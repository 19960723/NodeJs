{
  "name": "koa2-backend-template",
  "version": "1.0.0",
  "description": "Koa2 基础后端项目模板",
  "main": "src/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "dev:stable": "ts-node-dev --respawn --transpile-only --clear src/app.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.{js,ts}",
    "lint:fix": "eslint src/**/*.{js,ts} --fix",
    "format": "prettier --write src/**/*.{js,ts}",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:init": "ts-node scripts/init-db.ts",
    "db:setup": "node scripts/setup-database.js",
    "db:sync": "ts-node scripts/sync-database.ts",
    "db:sync:alter": "ts-node scripts/sync-database.ts --alter",
    "db:sync:force": "ts-node scripts/sync-database.ts --force",
    "rbac:init": "ts-node scripts/init-rbac.ts",
    "docker:build": "docker build -t koa2-app .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "koa2",
    "sequelize",
    "mysql",
    "backend",
    "api",
    "template"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@types/swagger-jsdoc": "^6.0.4",
    "dotenv": "^16.3.1",
    "joi": "^17.9.2",
    "koa": "^2.14.2",
    "koa-bodyparser": "^4.4.1",
    "koa-cors": "^0.0.16",
    "koa-helmet": "^7.0.2",
    "koa-router": "^12.0.0",
    "koa-static": "^5.0.0",
    "mysql2": "^3.6.0",
    "sequelize": "^6.32.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-koa": "^0.0.1",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/koa": "^3.0.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-cors": "^0.0.6",
    "@types/koa-router": "^7.4.8",
    "@types/node": "^20.6.0",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jest": "^29.6.2",
    "lint-staged": "^13.2.3",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "sequelize-cli": "^6.6.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "@types/jsonwebtoken": "^9.0.6"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
